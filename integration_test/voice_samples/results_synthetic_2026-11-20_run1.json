      "status": "ok",
      "stt_ms": 7419,
      "audio_seconds": 11.3813125,
      "stt_text": "Let's schedule the design review for Tuesday. No wait not Tuesday, make it Wednesday at 11, because Rahul is out on Tuesday. And send the invite to the whole team, not just the designers.",
      "wer": 0.029411764705882353,
      "llm_total_ms": 10415,
      "llm_ttft_ms": 5036,
      "llm_chunks": 48,
      "llm_timed_out": false,
