<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card: a hairline gradient border underneath, the diagonal-gradient surface inset by 1dp on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/capture_widget_border_end"
                android:startColor="@color/capture_widget_border_start"
                android:type="linear" />
            <corners android:radius="@dimen/capture_widget_corner_radius" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/capture_widget_surface_end"
                android:startColor="@color/capture_widget_surface"
                android:type="linear" />
            <corners android:radius="@dimen/capture_widget_corner_radius" />
        </shape>
    </item>
</layer-list>
